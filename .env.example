# MongoDB Connection String (Leave empty to auto-start local in-memory MongoDB for instant preview/testing)
MONGO_URI="mongodb://127.0.0.1:27017/campusconnect"

# JWT Secret Key for signing authentication tokens
JWT_SECRET="campusconnect_super_secret_jwt_key_change_in_production"

# Server Port
PORT=3000

# Application URL
APP_URL="http://localhost:3000"
